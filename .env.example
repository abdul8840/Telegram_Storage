# ─────────────────────────────────────────────────────────────
# Telegram Cloud Drive — environment configuration
# Copy to .env and fill in. Everything has a sane default.
# ─────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
PORT=5000
# Bind address (0.0.0.0 = all interfaces, needed for containers/previews)
HOST=0.0.0.0
NODE_ENV=development
# Public origin of the app (used in share links). Leave blank to auto-detect.
PUBLIC_URL=
# Comma separated list of allowed CORS origins ("*" = any)
CORS_ORIGINS=http://192.168.1.4:5173,http://localhost:5173/
# Secret used to sign JWTs — CHANGE THIS IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ── Database ─────────────────────────────────────────────────
# MongoDB connection string (Atlas or self-hosted).
# If empty, the server automatically uses the zero-config embedded
# database in ./data — perfect for local development.
MONGODB_URI=mongodb+srv://liosam614_db_user:<db_password>@cluster0.e1sxnjs.mongodb.net/?appName=Cluster0
MONGODB_DB=telegram_cloud

# ── Storage backend ──────────────────────────────────────────
# "telegram" = store files in your Telegram account (real cloud)
# "local"    = store files on this machine (demo / offline mode)
STORAGE_PROVIDER=telegram
# Where the local provider keeps files
LOCAL_STORAGE_PATH=./data/storage

# ── Telegram (MTProto) credentials ───────────────────────────
# Get api_id + api_hash from https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
TG_PHONE=
# Where files are uploaded:
#   "me"            → Saved Messages (default, private, unlimited)
#   a chat/channel  → e.g. @my_cloud_channel, -1001234567890, or t.me/xxxx
TG_CHAT_TARGET=me
# Upload tuning
TG_UPLOAD_WORKERS=3
TG_UPLOAD_PART_KB=512
TG_MAX_CONCURRENT_UPLOADS=2

# ── Media pipeline (optional) ────────────────────────────────
# ffmpeg enables video thumbnails, codec detection and HEVC → H.264 transcoding.
# Auto-detected on PATH, or point at a binary explicitly.
FFMPEG_PATH=
FFPROBE_PATH=
# Set to 0 to disable transcoding on low-power machines
ENABLE_TRANSCODE=1
THUMB_PATH=./data/thumbs
TMP_PATH=./data/tmp

# ── Limits ───────────────────────────────────────────────────
# Max upload size in bytes (default 4 GB — Telegram premium limit)
MAX_UPLOAD_SIZE=4294967296
# Chunk size used by the resumable uploader (bytes)
UPLOAD_CHUNK_SIZE=8388608
# Max bytes returned by the inline text/code preview
MAX_TEXT_PREVIEW=524288

# ── Security ─────────────────────────────────────────────────
# AES key used to encrypt stored Telegram session strings.
# Falls back to JWT_SECRET — set both in production.
SESSION_ENCRYPTION_KEY=
# Set to false to close new registrations
ALLOW_SIGNUP=true

# ── Retention & paths ────────────────────────────────────────
# Days a file stays in Trash before it is purged automatically
TRASH_AUTO_PURGE_DAYS=30
# Root data directory (embedded DB, storage, thumbs, temp uploads)
DATA_DIR=./data
UPLOAD_TMP_PATH=./data/uploads
# Where the built React app is served from
CLIENT_DIST=./client/dist

# ── Media tuning ─────────────────────────────────────────────
THUMB_WIDTH=480
# Tiny inline placeholder (blur-up) width in px
LQIP_WIDTH=24

# ── Telegram tuning (advanced) ───────────────────────────────
TG_MAX_CONCURRENT_DOWNLOADS=4
TG_CLIENT_IDLE_MS=600000
TG_SESSION_NAME=TelegramCloudDrive
TG_DEVICE_MODEL=TelegramCloud
