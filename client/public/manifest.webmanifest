{
  "name": "ZoZoCloud",
  "short_name": "ZoZoCloud",
  "description": "An independently operated personal file library backed by your own Telegram account. Not affiliated with Telegram.",
  "start_url": "/drive",
  "scope": "/",
  "display": "standalone",
  "background_color": "#070a13",
  "theme_color": "#0b1020",
  "orientation": "any",
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
